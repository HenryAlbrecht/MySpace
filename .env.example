# Opcional: Steam funciona sem preencher estas credenciais.
# Copie para .env e preencha somente para ativar IGDB.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Last.fm: chave para consultas públicas de música e recomendações.
# Shared Secret não é necessário para essas consultas.
LASTFM_API_KEY=

# PARTY: listas separadas por vírgula ou espaço. Sem TURN, usa STUN.
PARTY_STUN_URLS=stun:stun.l.google.com:19302
PARTY_TURN_URLS=
# Exemplo: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PARTY_TURN_SECRET=
PARTY_TURN_TTL=3600
# Obrigatório com TURN em NODE_ENV=production; origens exatas, sem barra final.
PARTY_ALLOWED_ORIGINS=
# Exemplo: https://party.example.com
VOICE_HOST=127.0.0.1
VOICE_PORT=8787

# ICE provider: coturn (default) ou metered. Valores privados só no ambiente/.env.
PARTY_ICE_PROVIDER=coturn
METERED_DOMAIN=
METERED_TURN_API_KEY=
